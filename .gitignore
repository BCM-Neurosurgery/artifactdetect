# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
venv/
env/
.venv/
build/
dist/

# Pipeline output directories -- generated by running the script, not
# source files. Adjust if your out_dir convention differs.
artifact_output/
*_output/
*_artifacts/
*.csv.bak

# Generated figures/CSVs if they ever land at the repo root
w[0-9][0-9][0-9][0-9]_*.png
artifact_times.csv

# Secrets -- API keys, credentials, tokens. GitHub is for code, not
# secrets, even in a private repo. Never commit these.
.env
.env.*
!.env.example
*.pem
*.key
secrets.*

# Raw patient data -- never commit this. Keep session CSVs, settings
# JSON, and accel files local/untracked; share via secure lab storage,
# not git.
*.csv
*.json
!package.json

# OS junk
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/
*.swp
